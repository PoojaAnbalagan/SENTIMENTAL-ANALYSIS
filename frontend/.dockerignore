# =============================================================================
# Frontend .dockerignore
# Excludes files not needed inside the frontend Docker build context
# =============================================================================

# Dependencies (will be re-installed by npm ci inside the container)
node_modules/

# Previous build output
dist/
dist-ssr/

# Git history
.git/
.gitignore

# Docker files (don't need to nest these)
Dockerfile
.dockerignore

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Local environment overrides
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docs
README.md
